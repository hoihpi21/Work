# AI Providers (provide at least one for cloud transcription & Burmese translation/recap)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Premium TTS Provider (free Edge TTS multi-voice works without any key)
ELEVENLABS_API_KEY=

# Storage & Limits
STORAGE_DIR=./storage
DATABASE_URL=sqlite:///./storage/movie_recap.db
MAX_VIDEO_DURATION_SEC=3600
CORS_ORIGINS=*
